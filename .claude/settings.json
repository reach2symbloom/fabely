{
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git fetch *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(git rev-parse *)",
      "Bash(git merge-base *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git merge *)",
      "Bash(pnpm *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(python3 *)",
      "Bash(curl http://localhost*)",
      "Bash(curl https://localhost*)",
      "Bash(curl localhost*)",
      "Bash(curl -s http://localhost*)",
      "Bash(curl *localhost*)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(lsof -ti :6006*)",
      "Bash(lsof -i *)",
      "Bash(xargs -r kill*)",
      "Bash(cat > /tmp/*)",
      "Bash(rm -f /tmp/*)",
      "Bash(rm -f /private/tmp/*)",
      "Bash(nohup pnpm storybook*)",
      "Bash(sleep *)",
      "Bash(seq *)",
      "Bash(disown*)",
      "Read(/tmp/**)",
      "Read(/private/tmp/**)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git push --force*)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(git clean *)",
      "Bash(rm *)",
      "Bash(kill *)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff"
          }
        ]
      }
    ]
  }
}
